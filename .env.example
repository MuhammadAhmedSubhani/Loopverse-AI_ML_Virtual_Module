# Names only. Copy to .env (never commit .env).
ARES_DB=ares.db
ARES_DELAY=0.2
ARES_MAX_ROUNDS=8
ARES_TIMEOUT_S=75
ARES_API=http://localhost:8000
# --- LLM agents (set ARES_USE_LLM=1 to enable; otherwise rule-based fallback) ---
ARES_USE_LLM=1   # optional: a key set here or in the dashboard enables LLM; 0 forces rule-based
ARES_LLM_PROVIDER=anthropic          # anthropic | gemini | openai | groq | openrouter | ollama  (openai = any OpenAI-compatible API: OpenAI, Groq, OpenRouter, Ollama)
ARES_LLM_API_KEY=
ARES_LLM_MODEL=claude-sonnet-5
ARES_LLM_BASE_URL=   # optional override; leave blank to use the selected provider preset
ARES_LLM_TIMEOUT=8
